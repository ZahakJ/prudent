diff --git a/kestrel/fetch.py b/kestrel/fetch.py
index 94ea3fc..8d27e84 100644
--- a/kestrel/fetch.py
+++ b/kestrel/fetch.py
@@ -1,12 +1,28 @@
-"""Download feeds over HTTP."""
+"""Download feeds over HTTP, retrying transient failures."""
 
+import time
+import urllib.error
 import urllib.request
 
 USER_AGENT = "kestrel/0.4"
+RETRY_STATUS = {429, 500, 502, 503, 504}
 
 
-def fetch(url, timeout=10):
-    """Return the body of url as bytes."""
+def fetch(url, timeout=10, retries=3, backoff=1.0, sleep=time.sleep):
+    """Return the body of url as bytes.
+
+    Retries up to `retries` times on connection errors and on the HTTP
+    statuses in RETRY_STATUS, waiting backoff, 2*backoff, 4*backoff... seconds.
+    """
     request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
-    with urllib.request.urlopen(request, timeout=timeout) as response:
-        return response.read()
+    for attempt in range(retries + 1):
+        try:
+            with urllib.request.urlopen(request, timeout=timeout) as response:
+                return response.read()
+        except urllib.error.HTTPError as e:
+            if e.code not in RETRY_STATUS or attempt == retries:
+                raise
+        except urllib.error.URLError:
+            if attempt == retries:
+                raise
+        sleep(backoff * 2 ** attempt)
