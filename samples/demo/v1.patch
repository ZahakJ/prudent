@@ -0,0 +1,47 @@
+import urllib.error
+
+import pytest
+
+from kestrel import fetch as fetch_module
+
+
+class FakeResponse:
+    def __init__(self, body):
+        self.body = body
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+    def read(self):
+        return self.body
+
+
+def failing_then(body, failures):
+    calls = []
+
+    def urlopen(request, timeout):
+        calls.append(request)
+        if len(calls) <= failures:
+            raise urllib.error.HTTPError(request.full_url, 503, "busy", {}, None)
+        return FakeResponse(body)
+
+    return urlopen, calls
+
+
+def test_retries_then_succeeds(monkeypatch):
+    urlopen, calls = failing_then(b"ok", failures=2)
+    monkeypatch.setattr(fetch_module.urllib.request, "urlopen", urlopen)
+    waits = []
+    assert fetch_module.fetch("http://x", sleep=waits.append) == b"ok"
+    assert waits == [1.0, 2.0]
+
+
+def test_gives_up(monkeypatch):
+    urlopen, calls = failing_then(b"ok", failures=10)
+    monkeypatch.setattr(fetch_module.urllib.request, "urlopen", urlopen)
+    with pytest.raises(urllib.error.HTTPError):
+        fetch_module.fetch("http://x", retries=2, sleep=lambda s: None)
+    assert len(calls) == 3
